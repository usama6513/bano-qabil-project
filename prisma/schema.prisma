model Deadline {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  title           String
  description     String?
  deadlineDate    DateTime @map("deadline_date")
  deadlineType    String   @map("deadline_type")
  sourceType      String?  @map("source_type")
  sourceId        String?  @map("source_id")
  isVerified      Boolean  @default(false) @map("is_verified")
  lastVerifiedAt  DateTime? @map("last_verified_at")
  status          String   @default("upcoming")
  reminderDaysBefore Int @default(7) @map("reminder_days_before")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId])
  @@index([deadlineDate])
  @@index([deadlineType])
  @@index([status])
  @@index([isVerified])
  @@map("deadlines")
}

model Notification {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  deadlineId       String?  @map("deadline_id")
  title            String
  message          String
  notificationType String   @map("notification_type")
  priority         String   @default("normal")
  isRead           Boolean  @default(false) @map("is_read")
  readAt           DateTime? @map("read_at")
  metadataJson     String?  @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadline Deadline? @relation(fields: [deadlineId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([notificationType])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  emailEnabled           Boolean  @default(false) @map("email_enabled")
  inAppEnabled           Boolean  @default(true) @map("in_app_enabled")
  scholarshipAlerts      Boolean  @default(true) @map("scholarship_alerts")
  universityAlerts       Boolean  @default(true) @map("university_alerts")
  applicationAlerts      Boolean  @default(true) @map("application_alerts")
  studyAlerts            Boolean  @default(true) @map("study_alerts")
  budgetAlerts           Boolean  @default(true) @map("budget_alerts")
  reminderDaysBefore     Int      @default(7) @map("reminder_days_before")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ============================================
// PHASE 16: MULTI-COUNTRY EDUCATION INTELLIGENCE
// ============================================

model CountryProfile {
  id                    String   @id @default(uuid())
  name                  String
  code                  String   @unique
  region                String?
  capital               String?
  currency              String
  language              String
  educationSystem       String?  @map("education_system")
  timezone              String?
  costOfLivingIndex     Float?   @map("cost_of_living_index")
  qualityOfLifeIndex    Float?   @map("quality_of_life_index")
  safetyIndex           Float?   @map("safety_index")
  popularForStudents    Boolean  @default(false) @map("popular_for_students")
  profileImageUrl       String?  @map("profile_image_url")
  overview              String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  authorities       CountryEducationAuthority[]
  visaSources       CountryVisaSource[]
  reportingBodies   CountryReportingAuthority[]
  costInfo          CountryCostInfo[]
  scholarships      CountryScholarship[]
  admissionReqs     CountryAdmissionRequirement[]

  @@index([code])
  @@index([region])
  @@index([popularForStudents])
  @@map("country_profiles")
}

model CountryEducationAuthority {
  id             String   @id @default(uuid())
  countryId      String   @map("country_id")
  name           String
  acronym        String?
  type           String
  description    String?
  websiteUrl     String?  @map("website_url")
  isVerified     Boolean  @default(false) @map("is_verified")
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")

  country CountryProfile @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([type])
  @@map("country_education_authorities")
}

model CountryVisaSource {
  id             String   @id @default(uuid())
  countryId      String   @map("country_id")
  sourceName     String   @map("source_name")
  sourceUrl      String?  @map("source_url")
  visaType       String   @map("visa_type")
  description    String?
  processingTime String?  @map("processing_time")
  requirements   String?
  isVerified     Boolean  @default(false) @map("is_verified")
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")

  country CountryProfile @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([visaType])
  @@map("country_visa_sources")
}

model CountryReportingAuthority {
  id             String   @id @default(uuid())
  countryId      String   @map("country_id")
  name           String
  type           String
  description    String?
  websiteUrl     String?  @map("website_url")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  isVerified     Boolean  @default(false) @map("is_verified")
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")

  country CountryProfile @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([type])
  @@map("country_reporting_authorities")
}

model CountryCostInfo {
  id                String   @id @default(uuid())
  countryId         String   @map("country_id")
  category          String
  subcategory       String?
  averageCost       Decimal  @map("average_cost")
  currency          String
  period            String?
  sourceName        String?  @map("source_name")
  sourceUrl         String?  @map("source_url")
  isVerified        Boolean  @default(false) @map("is_verified")
  lastVerifiedAt    DateTime? @map("last_verified_at")
  year              Int?
  createdAt         DateTime @default(now()) @map("created_at")

  country CountryProfile @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([category])
  @@map("country_cost_info")
}

model CountryScholarship {
  id               String   @id @default(uuid())
  countryId        String   @map("country_id")
  name             String
  provider         String
  type             String
  amount           String?
  currency         String?
  coverage         String?
  eligibility      String?
  deadline         DateTime?
  applicationUrl   String?  @map("application_url")
  description      String?
  isVerified       Boolean  @default(false) @map("is_verified")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  createdAt        DateTime @default(now()) @map("created_at")

  country CountryProfile @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([type])
  @@index([deadline])
  @@map("country_scholarships")
}

model CountryAdmissionRequirement {
  id              String   @id @default(uuid())
  countryId       String   @map("country_id")
  level           String
  requirementType String   @map("requirement_type")
  description     String
  details         String?
  isVerified      Boolean  @default(false) @map("is_verified")
  lastVerifiedAt  DateTime? @map("last_verified_at")
  createdAt       DateTime @default(now()) @map("created_at")

  country CountryProfile @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([level])
  @@index([requirementType])
  @@map("country_admission_requirements")
}

// ============================================
// PHASE 17: FINANCIAL EDUCATION INTELLIGENCE
// ============================================

model EducationCostPlan {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  title           String
  countryId       String?  @map("country_id")
  targetCountry   String?  @map("target_country")
  targetUniversity String? @map("target_university")
  studyLevel      String?  @map("study_level")
  studyField      String?  @map("study_field")
  startDate       DateTime? @map("start_date")
  status          String   @default("draft")
  notes           String?
  currency        String   @default("USD")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items EducationCostItem[]

  @@index([userId])
  @@index([status])
  @@map("education_cost_plans")
}

model EducationCostItem {
  id               String   @id @default(uuid())
  planId           String   @map("plan_id")
  category         String
  label            String
  description      String?
  amount           Decimal
  currency         String
  verificationStatus String @map("verification_status")
  sourceType       String?  @map("source_type")
  sourceUrl        String?  @map("source_url")
  isRequired       Boolean  @default(true) @map("is_required")
  quantity         Int      @default(1)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  plan EducationCostPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([category])
  @@index([verificationStatus])
  @@map("education_cost_items")
}

// ==================== Government Schemes for Pakistani Students ====================

model GovernmentScheme {
  id                    String             @id @default(uuid())
  name                  String
  provider              String
  category              String
  description           String?
  eligibilityCriteria   String?            @map("eligibility_criteria")
  applicationProcess    String?            @map("application_process")
  deadline              DateTime?
  amount                Decimal?
  currency              String?
  website               String?
  province              String?
  targetAudience        String?            @map("target_audience")
  status                String             @default("active")
  sourceUrl             String?            @map("source_url")
  sourceName            String?            @map("source_name")
  verificationStatus    String             @default("pending") @map("verification_status")
  lastVerifiedAt        DateTime?          @map("last_verified_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  requirements SchemeRequirement[]
  documents    SchemeDocument[]

  @@index([category])
  @@index([province])
  @@index([status])
  @@index([verificationStatus])
  @@map("government_schemes")
}

model SchemeRequirement {
  id               String   @id @default(uuid())
  schemeId         String   @map("scheme_id")
  requirementType  String   @map("requirement_type")
  requirementValue String   @map("requirement_value")
  isRequired       Boolean  @default(true) @map("is_required")
  createdAt        DateTime @default(now()) @map("created_at")

  scheme GovernmentScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId])
  @@map("scheme_requirements")
}

model SchemeDocument {
  id           String   @id @default(uuid())
  schemeId     String   @map("scheme_id")
  documentName String   @map("document_name")
  description  String?
  isRequired   Boolean  @default(true) @map("is_required")
  createdAt    DateTime @default(now()) @map("created_at")

  scheme GovernmentScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId])
  @@map("scheme_documents")
}

// ==================== Free Course Institutions ====================

model FreeInstitution {
  id                    String             @id @default(uuid())
  name                  String
  type                  String
  description           String?
  website               String?
  location              String?
  province              String?
  contactEmail          String?            @map("contact_email")
  contactPhone          String?            @map("contact_phone")
  eligibilityCriteria   String?            @map("eligibility_criteria")
  applicationProcess    String?            @map("application_process")
  status                String             @default("active")
  sourceUrl             String?            @map("source_url")
  sourceName            String?            @map("source_name")
  verificationStatus    String             @default("pending") @map("verification_status")
  lastVerifiedAt        DateTime?          @map("last_verified_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  courses    InstitutionCourse[]
  entryTests InstitutionEntryTest[]
  documents  InstitutionDocument[]

  @@index([type])
  @@index([province])
  @@index([verificationStatus])
  @@map("free_institutions")
}

model InstitutionCourse {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String
  duration      String?
  description   String?
  fee           String?
  certification String?
  batchStart    String?  @map("batch_start")
  createdAt     DateTime @default(now()) @map("created_at")

  institution FreeInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("institution_courses")
}

model InstitutionEntryTest {
  id                String   @id @default(uuid())
  institutionId     String   @map("institution_id")
  testName          String   @map("test_name")
  type              String?
  totalMarks        Int?     @map("total_marks")
  passingMarks      Int?     @map("passing_marks")
  passingPercentage String?  @map("passing_percentage")
  syllabus          String?
  preparationTips   String?  @map("preparation_tips")
  createdAt         DateTime @default(now()) @map("created_at")

  institution FreeInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("institution_entry_tests")
}

model InstitutionDocument {
  id           String   @id @default(uuid())
  institutionId String  @map("institution_id")
  documentName String   @map("document_name")
  description  String?
  isRequired   Boolean  @default(true) @map("is_required")
  createdAt    DateTime @default(now()) @map("created_at")

  institution FreeInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("institution_documents")
}

// ===== INTERNSHIP / FELLOWSHIP / HOUSE JOB SYSTEM =====
model Internship {
  id                  String   @id @default(uuid())
  title               String
  organization        String
  country             String
  city                String?
  type                String   // internship, fellowship, house_job, clerkship, observership
  field               String   // medicine, engineering, CS, business, law, research, etc.
  paidType            String   // paid, unpaid, stipend, conditional
  stipendAmount       String?  // e.g. "PKR 30,000/month", "USD 5,000/month"
  duration            String   // e.g. "3 months", "6 months", "1 year"
  mode                String   @default("onsite") // onsite, remote, hybrid
  eligibility         String   // who can apply
  requirements        String   // documents, qualifications needed
  documentsRequired   String?  // specific list of documents to submit
  benefits            String   // what the intern gains
  applicationUrl      String?  @map("application_url")
  deadline            DateTime?
  description         String?
  isVerified          Boolean  @default(false) @map("is_verified")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@index([type])
  @@index([field])
  @@index([paidType])
  @@map("internships")
}

// ===== CM PROGRAMS (All Provinces) =====
model CMProgram {
  id              String   @id @default(uuid())
  name            String
  province        String   // Punjab, Sindh, KPK, Balochistan, Islamabad
  category        String   // scholarship, laptop, internship, health, housing, skill, financial_aid
  description     String
  eligibility     String
  benefits        String
  howToApply      String   @map("how_to_apply")
  deadline        DateTime?
  officialUrl     String?  @map("official_url")
  targetAudience  String   @map("target_audience")  // students, youth, women, farmers, etc.
  status          String   @default("active")  // active, upcoming, closed
  isVerified      Boolean  @default(false) @map("is_verified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([province])
  @@index([category])
  @@index([status])
  @@map("cm_programs")
}

// ===== DEPARTMENTS =====
model Department {
  id              String   @id @default(uuid())
  universityId    String   @map("university_id")
  name            String
  head            String?
  description     String?
  totalCourses    Int      @default(0) @map("total_courses")
  createdAt       DateTime @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, name])
  @@index([universityId])
  @@map("departments")
}
