generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Models
// ============================================================

// 1. User
model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String             @map("password_hash")
  emailVerified     DateTime?          @map("email_verified")
  name              String
  country           String?
  preferredLanguage String  @default("auto") @map("preferred_language")
  role              String           @default("user")
  avatarUrl         String?            @map("avatar_url")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")

  profile                Profile?
  conversations          Conversation[]
  conversationMessages   ConversationMessage[]
  documents              Document[]
  fraudReports           FraudReport[]
  urlScans               UrlScan[]
  budgetProfile          BudgetProfile?
  learningProfile        LearningProfile?
  studyPlans             StudyPlan[]
  teacherProfile         TeacherProfile?
  studentProfile         StudentProfile?
  auditLogs              AuditLog[]
  expenseCategories      ExpenseCategory[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens          RefreshToken[]
  aiUsageLogs            AIUsageLog[]
  memories               UserMemory[]
  settings               UserSettings?
  savedCourses           SavedCourse[]
  savedUniversities      SavedUniversity[]
  savedScholarships      SavedScholarship[]
  applicationChecklists  ApplicationChecklist[]
  userReports            UserReport[]
  documentAnalysisResults DocumentAnalysisResult[]
  applicationWorkspaces  ApplicationWorkspace[]
  savingsGoals           SavingsGoal[]
  studySessions          StudySession[]
  practiceQuizzes        PracticeQuiz[]
  performanceMetrics     PerformanceMetric[]
  revisionPlans          RevisionPlan[]
  studyTopics            StudyTopic[]
  dailySchedules         DailySchedule[]
  teacherLessonPlans     TeacherLessonPlan[]
  teacherAssessments     TeacherAssessment[]
  teacherHomework        TeacherHomework[]
  teacherRubrics         TeacherRubric[]
  classrooms             Classroom[]
  classroomEnrollments   ClassroomEnrollment[]
  classroomResources     ClassroomResource[]
  deadlines              Deadline[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  educationCostPlans     EducationCostPlan[]
  dataChangeLogs         DataChangeLog[]
  sources                Source[]

  @@index([email])
  @@index([country])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

// 2. Profile
model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  bio             String?
  dateOfBirth     DateTime? @map("date_of_birth")
  phone           String?
  educationLevel  String?   @map("education_level")
  occupation      String?
  timezone        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

// 3. Conversation
model Conversation {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  title         String?
  status        String @default("active")
  isArchived    Boolean            @default(false) @map("is_archived")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  lastMessageAt DateTime?          @map("last_message_at")
  deletedAt     DateTime?          @map("deleted_at")

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
  summaries  ConversationSummary[]

  @@index([userId])
  @@index([status])
  @@index([isArchived])
  @@index([lastMessageAt])
  @@index([deletedAt])
  @@map("conversations")
}

// 4. ConversationMessage
model ConversationMessage {
  id              String        @id @default(uuid())
  conversationId  String        @map("conversation_id")
  userId          String        @map("user_id")
  role            String
  content         String
  messageType     String   @default("text") @map("message_type")
  metadata        String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([role])
  @@index([messageType])
  @@index([createdAt])
  @@map("conversation_messages")
}

// 5. ConversationSummary
model ConversationSummary {
  id               String   @id @default(uuid())
  conversationId   String   @map("conversation_id")
  summaryText      String   @map("summary_text")
  importantFacts   String?  @map("important_facts")
  tokenCount       Int      @map("token_count")
  messageRangeStart Int     @map("message_range_start")
  messageRangeEnd   Int     @map("message_range_end")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_summaries")
}

// 6. University
model University {
  id                 String             @id @default(uuid())
  name               String
  country            String
  city               String?
  website            String?
  logoUrl            String?            @map("logo_url")
  description        String?
  ranking            Int?
  foundedYear        Int?               @map("founded_year")
  type               String     @default("university")
  sector             String?    @default("public")
  sourceUrl          String?            @map("source_url")
  sourceName         String?            @map("source_name")
  verificationStatus String @default("pending") @map("verification_status")
  lastVerifiedAt     DateTime?          @map("last_verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // AI Knowledge Fields — real university data for chatbot
  closingMerit       String?            @map("closing_merit")        // e.g. "BS CS: 92%, BS EE: 88%"
  entryTestDetails   String?            @map("entry_test_details")   // e.g. "NET: 80 MCQs (Math 40, Physics 20, English 20), 3 hours"
  isOpenMerit        Boolean?           @map("is_open_merit")        // open merit admissions?
  supplyPolicy       String?            @map("supply_policy")        // what to do if paper supply
  feeRange           String?            @map("fee_range")            // e.g. "PKR 150,000-300,000/semester"
  admissionProcess   String?            @map("admission_process")    // how to apply step by step
  scholarshipsOffered String?           @map("scholarships_offered") // uni-specific scholarships
  admissionDates     String?            @map("admission_dates")      // e.g. "Fall: Aug-Oct, Spring: Jan-Mar"
  examSystem         String?            @map("exam_system")          // "semester" or "yearly" or "mixed"

  courses              Course[]
  departments          Department[]
  admissionRequirements AdmissionRequirement[]
  savedBy              SavedUniversity[]
  rankings             UniversityRanking[]
  campuses             Campus[]

  @@index([country])
  @@index([city])
  @@index([type])
  @@index([sector])
  @@index([verificationStatus])
  @@index([ranking])
  @@map("universities")
}

// 6b. Campus (main campus + sub campuses)
model Campus {
  id              String   @id @default(uuid())
  universityId    String   @map("university_id")
  name            String
  city            String?
  address         String?
  isMain          Boolean  @default(false) @map("is_main")
  phone           String?
  email           String?
  website         String?
  description     String?
  facilities      String?  // JSON array of facilities
  programs        String?  // JSON array of programs offered at this campus
  admissionContact String? @map("admission_contact")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([city])
  @@index([isMain])
  @@map("campuses")
}

// 7. Course
model Course {
  id            String   @id @default(uuid())
  universityId  String   @map("university_id")
  name          String
  degree        String
  department    String?
  duration      String?
  language      String?
  tuitionFee    Decimal? @map("tuition_fee")
  currency      String? 
  description   String?
  sourceUrl     String?  @map("source_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  university           University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  admissionRequirements AdmissionRequirement[]
  savedBy              SavedCourse[]

  verificationStatus String  @default("unverified") @map("verification_status")
  lastVerifiedAt     DateTime? @map("last_verified_at")

  @@index([universityId])
  @@index([degree])
  @@index([department])
  @@index([language])
  @@map("courses")
}

// 8. Scholarship
model Scholarship {
  id                   String             @id @default(uuid())
  name                 String
  provider             String
  country              String?
  category             String?            @default("international") // local (Pakistan) or international
  amount               Decimal?
  currency             String?
  amountFrequency      String?            @default("monthly") // monthly, annual, one_time, total
  deadline             DateTime?
  description          String?
  eligibilityCriteria  String?            @map("eligibility_criteria")
  applicationProcess   String?            @map("application_process")
  documentsRequired    String?            @map("documents_required")
  contactInfo          String?            @map("contact_info")
  sourceUrl            String?            @map("source_url")
  sourceName           String?            @map("source_name")
  verificationStatus   String @default("pending") @map("verification_status")
  lastVerifiedAt       DateTime?          @map("last_verified_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  requirements ScholarshipRequirement[]
  savedBy      SavedScholarship[]
}

// 9. ScholarshipRequirement
model ScholarshipRequirement {
  id               String   @id @default(uuid())
  scholarshipId    String   @map("scholarship_id")
  requirementType  String   @map("requirement_type")
  requirementValue String   @map("requirement_value")
  isRequired       Boolean  @default(true) @map("is_required")
  createdAt        DateTime @default(now()) @map("created_at")

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId])
  @@index([requirementType])
  @@map("scholarship_requirements")
}

// 10. Country
model Country {
  id              String   @id @default(uuid())
  name            String   @unique
  code            String   @unique
  continent       String?
  visaRequired    Boolean  @default(false) @map("visa_required")
  costOfLiving    Decimal? @map("cost_of_living")
  safetyIndex     Decimal? @map("safety_index")
  educationSystem String?  @map("education_system")
  sourceUrl       String?  @map("source_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  admissionRequirements AdmissionRequirement[]
  visaInformation       VisaInformation[]

  @@index([code])
  @@index([continent])
  @@map("countries")
}

// 11. AdmissionRequirement
model AdmissionRequirement {
  id               String   @id @default(uuid())
  universityId     String   @map("university_id")
  courseId          String?  @map("course_id")
  countryId        String   @map("country_id")
  requirementType  String   @map("requirement_type")
  requirementValue String   @map("requirement_value")
  deadline         DateTime?
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  course     Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([courseId])
  @@index([countryId])
  @@index([requirementType])
  @@map("admission_requirements")
}

// 12. VisaInformation
model VisaInformation {
  id              String   @id @default(uuid())
  countryId       String   @map("country_id")
  visaType        String   @map("visa_type")
  requirements    String?
  processingTime  String?  @map("processing_time")
  fee             Decimal?
  sourceUrl       String?  @map("source_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  verificationStatus String  @default("unverified") @map("verification_status")
  lastVerifiedAt     DateTime? @map("last_verified_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([visaType])
  @@map("visa_information")
}

// 13. Document
model Document {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  fileName     String         @map("file_name")
  originalName String         @map("original_name")
  mimeType     String         @map("mime_type")
  fileSize     Int            @map("file_size")
  filePath     String         @map("file_path")
  status       String @default("processing")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans DocumentScan[]

  @@index([userId])
  @@index([status])
  @@index([mimeType])
  @@index([deletedAt])
  @@map("documents")
}

// 14. DocumentScan
model DocumentScan {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  extractedText String? @map("extracted_text")
  scanResult   String?    @map("scan_result")
  riskScore    Decimal? @map("risk_score")
  createdAt    DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_scans")
}

// 15. FraudReport
model FraudReport {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  inputType     String    @map("input_type")
  inputContent  String?           @map("input_content")
  inputFilePath String?           @map("input_file_path")
  riskScore     Decimal?          @map("risk_score")
  riskLevel     String         @default("low") @map("risk_level")
  analysis      String?
  evidenceJson  String?          @map("evidence_json")
  recommendation String?
  status        String @default("pending")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicators   FraudIndicator[]
  evidenceList FraudEvidence[]

  @@index([userId])
  @@index([status])
  @@index([riskLevel])
  @@index([inputType])
  @@index([createdAt])
  @@map("fraud_reports")
}

// 16. FraudIndicator
model FraudIndicator {
  id              String        @id @default(uuid())
  fraudReportId   String        @map("fraud_report_id")
  indicatorType   String        @map("indicator_type")
  indicatorValue  String        @map("indicator_value")
  confidence      Decimal      
  severity        String
  description     String?
  createdAt       DateTime      @default(now()) @map("created_at")

  fraudReport FraudReport @relation(fields: [fraudReportId], references: [id], onDelete: Cascade)

  @@index([fraudReportId])
  @@index([indicatorType])
  @@index([severity])
  @@map("fraud_indicators")
}

// 17. UrlScan
model UrlScan {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  url             String
  domain          String?
  isHttps         Boolean        @default(false) @map("is_https")
  hasRedirect     Boolean        @default(false) @map("has_redirect")
  redirectUrl     String?        @map("redirect_url")
  reputationScore Decimal?       @map("reputation_score")
  riskLevel       String?
  analysis        String?
  status          String  @default("pending")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  indicators UrlIndicator[]

  @@index([userId])
  @@index([status])
  @@index([domain])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("url_scans")
}

// 18. CyberAuthority
model CyberAuthority {
  id               String    @id @default(uuid())
  name             String
  country          String
  type             String
  category         String?
  website          String?
  phone            String?
  email            String?
  address          String?
  reportingUrl     String?   @map("reporting_url")
  description      String?
  verificationStatus String @default("unverified") @map("verification_status")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  complaintProcedures ComplaintProcedure[]

  @@index([country])
  @@index([type])
  @@index([category])
  @@map("cyber_authorities")
}

// 19. ComplaintProcedure
model ComplaintProcedure {
  id                String   @id @default(uuid())
  authorityId       String   @map("authority_id")
  country           String
  category          String
  procedureSteps    String   @map("procedure_steps")
  requiredDocuments String?    @map("required_documents")
  estimatedTime     String?  @map("estimated_time")
  cost              Decimal?
  sourceUrl         String?  @map("source_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  verificationStatus String  @default("unverified") @map("verification_status")
  lastVerifiedAt     DateTime? @map("last_verified_at")

  authority CyberAuthority @relation(fields: [authorityId], references: [id], onDelete: Cascade)

  @@index([authorityId])
  @@index([country])
  @@index([category])
  @@map("complaint_procedures")
}

// 20. BudgetProfile
model BudgetProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  monthlyIncome Decimal? @map("monthly_income")
  currency    String   @default("USD")
  savingsGoal Decimal? @map("savings_goal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeRecords  IncomeRecord[]
  expenseRecords ExpenseRecord[]
  budgets        Budget[]

  @@index([userId])
  @@map("budget_profiles")
}

// 21. IncomeRecord
model IncomeRecord {
  id              String           @id @default(uuid())
  budgetProfileId String           @map("budget_profile_id")
  source          String
  amount          Decimal         
  frequency       String  @default("monthly")
  isVerified      Boolean          @default(false) @map("is_verified")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  budgetProfile BudgetProfile @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)

  @@index([budgetProfileId])
  @@index([frequency])
  @@map("income_records")
}

// 22. ExpenseCategory
model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  color     String? 
  isDefault Boolean  @default(false) @map("is_default")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseRecords ExpenseRecord[]
  budgets        Budget[]

  @@index([userId])
  @@index([isDefault])
  @@map("expense_categories")
}

// 23. ExpenseRecord
model ExpenseRecord {
  id               String          @id @default(uuid())
  budgetProfileId  String          @map("budget_profile_id")
  categoryId       String          @map("category_id")
  amount           Decimal        
  description      String?
  date             DateTime
  isRecurring      Boolean         @default(false) @map("is_recurring")
  recurringFrequency String?       @map("recurring_frequency")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  budgetProfile BudgetProfile   @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([budgetProfileId])
  @@index([categoryId])
  @@index([date])
  @@map("expense_records")
}

// 24. Budget
model Budget {
  id              String       @id @default(uuid())
  budgetProfileId String       @map("budget_profile_id")
  categoryId      String       @map("category_id")
  amount          Decimal     
  period          String @default("monthly")
  spent           Decimal      @default(0)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  budgetProfile BudgetProfile   @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([budgetProfileId])
  @@index([categoryId])
  @@index([period])
  @@unique([budgetProfileId, categoryId, period])
  @@map("budgets")
}

// 25. LearningProfile
model LearningProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  educationLevel  String?  @map("education_level")
  subjects        String?
  weakSubjects    String?    @map("weak_subjects")
  learningStyle   String?  @map("learning_style")
  studyHoursPerDay Int?    @map("study_hours_per_day")
  targetExam      String?  @map("target_exam")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlans    StudyPlan[]
  studentProfiles StudentProfile[]

  @@index([userId])
  @@map("learning_profiles")
}

// 26. StudyPlan
model StudyPlan {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  learningProfileId String        @map("learning_profile_id")
  title            String
  description      String?
  startDate        DateTime       @map("start_date")
  endDate          DateTime       @map("end_date")
  status           String @default("active")
  schedule         String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningProfile LearningProfile @relation(fields: [learningProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([learningProfileId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("study_plans")
}

// 27. TeacherProfile
model TeacherProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  subjects      String?
  qualifications String?
  experience    String?
  hourlyRate    Decimal? @map("hourly_rate")
  currency      String? 
  rating        Decimal?
  totalStudents Int      @default(0) @map("total_students")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("teacher_profiles")
}

// 28. StudentProfile
model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  learningProfileId String? @map("learning_profile_id")
  grade            String?
  school           String?
  weakSubjects     String?    @map("weak_subjects")
  goals            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningProfile LearningProfile? @relation(fields: [learningProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([learningProfileId])
  @@map("student_profiles")
}

// 29. Source
model Source {
  id                 String             @id @default(uuid())
  entityType         String             @map("entity_type")
  entityId           String             @map("entity_id")
  sourceUrl          String             @map("source_url")
  sourceName         String?            @map("source_name")
  sourceType         String             @map("source_type")
  verificationStatus String             @default("pending") @map("verification_status")
  lastVerifiedAt     DateTime?          @map("last_verified_at")
